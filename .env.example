# Copy to .env and fill in.

# Required for --provider openai-api (the default).
OPENAI_API_KEY=sk-...

# Model used for simulation reactions. Override per-run with --model.
POCKETSIM_MODEL=gpt-5.4

# Model used for cheap structural work (beat-mapping, persona prose).
POCKETSIM_UTILITY_MODEL=gpt-5.4

# Path to the Codex CLI binary, used by --provider codex-cli.
POCKETSIM_CODEX_BIN=codex

# Default concurrency for async fan-out against the API.
POCKETSIM_CONCURRENCY=16
